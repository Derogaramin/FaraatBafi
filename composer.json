{
  "name": "faraat/faraatbafi",
  "description": "سامانه جامع مدیریت تعاونی فرت‌بافی نقشینه بافت تربت جام — بازنویسی یکپارچه با PHP 8.2",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "chillerlan/php-qrcode": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "core/",
      "App\\Modules\\": "app/Modules/"
    },
    "files": ["core/helpers.php"]
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": {
    "serve": "php -S localhost:8080 -t public",
    "test": "phpunit"
  },
  "config": { "sort-packages": true }
}
